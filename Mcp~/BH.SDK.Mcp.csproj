<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MCP server a client launches over stdio: a thin forwarder to the running game's bridge. It
    compiles the SDK's pure Agent/ folder (through the ProjectReference) and nothing of Unity.

    In a tilde folder, so Unity never imports it, and BH.SDK.csproj excludes Mcp~ for the same reason.
    net8 because ModelContextProtocol targets modern .NET; the SDK stays netstandard2.1 for Unity.

    TRIMMING. The shipped binary is published trimmed (below). Tool classes are therefore registered
    one by one in Program.cs with WithTools<T>(): WithToolsFromAssembly() finds nothing in a trimmed
    binary. Every tool class must be NON-static for that.

    Nullable/ImplicitUsings are off like Samples~/ConsoleSmoke; Tests\ is its own project.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>bh-mcp</AssemblyName>
    <RootNamespace>BH.SDK.Mcp</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    The shipped shape, applied whenever a runtime identifier is given (`dotnet publish -r <rid>`). It is
    set HERE and not passed as -p:PublishTrimmed on the command line: a command-line property is global
    and would reach BH.SDK and BH.SDK.Roslyn through the ProjectReference, and a netstandard library
    cannot be trimmed (NETSDK1124).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BH.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

</Project>
