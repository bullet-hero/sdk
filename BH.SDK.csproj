<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The SDK compiled WITHOUT Unity - the same sources Unity builds from BH.SDK.asmdef, as a
    plain library a server or a tool can reference. That is not a side project: the SDK is
    deliberately engine-free (`noEngineReferences: true`, and every mention of UnityEngine in the
    core is a comment), and this file is what keeps that claim honest instead of merely stated.

    netstandard2.1 and C# 9 are NOT chosen here - they are what the Unity project compiles with
    (apiCompatibilityLevel 6 = .NET Standard 2.1). Raising either would let code in that Unity then
    refuses, which turns this project from a check into a second dialect.

    UNITYINTEGRATION/ IS INCLUDED WHOLE, and that is the difference between it and
    UnityExtensions/. Everything in UnityIntegration is DUAL by contract - every file compiles with
    and without an engine, `#if BHSDK_UNITY` choosing between the two - so it belongs to this
    library exactly as much as to the Unity one, and the rule is enforced by this project failing
    to build the moment a file breaks it. UnityExtensions/ makes no such promise: it needs
    UnityEngine, Unity.Mathematics and Unity.Collections unconditionally. See UnityIntegration's own
    README.md.

    FOUR FOLDERS ARE EXCLUDED, each for its own reason:
      Roslyn/          - analyzers/generators; its own project, and it targets netstandard2.0
                         against the compiler's Roslyn rather than this library's dependencies.
      UnityExtensions/ - genuinely engine-bound, see above.
      Tests/           - its own project, so `dotnet build` here builds no test framework in.
      Samples~/        - consumers of the BUILT DLL (ConsoleSmoke), each its own project.

    BHSDK_UNITY is deliberately NOT defined: it is what Player Settings define for the Unity build,
    and the whole point of this project is to compile the branch Unity never takes.
  -->

  <!--
    <Version> IS THE THIRD COPY OF THE SDK'S OWN VERSION, beside SdkVersion.cs and package.json, and
    it lives HERE rather than in Directory.Build.props on purpose: that file is shared by four
    projects, so a version in it would also stamp BH.SDK.Roslyn and both test assemblies, which
    version nothing. Services.Shared.Tests' SdkVersionAgreementTests fails the moment one of the
    three moves alone.

    A BETA is written `X.Y.ZbN` (Docs/VERSION-BUMP.md in the game repo, "A beta"), which NuGet
    refuses outright - restore fails before anything compiles. The conditional line rewrites it to
    the semver prerelease `X.Y.Z-beta.N` for this build only; the literal line stays the copy the
    agreement test and release.yml read, so it keeps the one spelling the other two copies have.
  -->

  <PropertyGroup>
    <Version>1.1.0b1</Version>
    <Version Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+b\d+$'))">$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '^(\d+\.\d+\.\d+)b(\d+)$', '$1-beta.$2'))</Version>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BH.SDK</AssemblyName>
    <RootNamespace>BH.SDK</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 (a public member with no XML doc) is ~2300 lines on its own, most of them generated
         model members; it would bury every warning that matters. The doc file still ships. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!--
      A Roslyn generator's output is added to the compilation, not written to Assets/ - which is
      correct (nothing can drift from its source) and leaves nothing to read. This dumps it under
      obj~/generated so a change to the generator can be diffed by eye. The tilde is why it is safe:
      Unity imports every folder under Assets/ that is not suffixed with one.
    -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj~\generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!--
    THE PACKAGE. `dotnet pack -c Release` produces a .nupkg of the same DLL `dotnet build` does, with
    its XML docs beside it. Nothing here publishes: pushing to nuget.org is the author's. The id is NOT
    the assembly name: the BH. prefix is reserved on nuget.org by another owner (a push of BH.SDK was
    refused with 409 on 2026-09-28), so the package is BulletHero.SDK and the DLL inside stays BH.SDK.
    <Version> above stays the one version, shared with the DLL.
  -->
  <PropertyGroup>
    <PackageId>BulletHero.SDK</PackageId>
    <Authors>vertoker</Authors>
    <Description>The open level and save data model of the game Bullet Hero: models, JSON and binary serialization with versioned envelopes and migrations, validation rules and level generators. Engine-free - usable from a server, a tool or a mod.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/bullet-hero/sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bullet-hero/sdk</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>bullet-hero;rhythm-game;bullet-hell;level-format;serialization;modding</PackageTags>
  </PropertyGroup>

  <!--
    PACKAGE HEALTH - what NuGet Package Explorer and nuget.org check. The PDB is EMBEDDED in the DLL
    rather than shipped as a .snupkg: one file, nothing for a consumer to fetch, and Source Link
    (built into the .NET 8 SDK) and the compiler flags both live inside it. ContinuousIntegrationBuild
    rewrites local paths to /_/, which is what makes the build reproducible; it is Release-only because
    a Debug build is for stepping through on this machine, where real paths are wanted. The generated
    model/validation sources are embedded by the compiler itself, since no repository holds them.
  -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The model generator, running on THIS build as well as on Unity's. Without it `dotnet build` here
    compiles 203 models whose IModel bodies do not exist, so the engine-free build stops being the
    check it is meant to be. ReferenceOutputAssembly=false: the components are a compiler plugin,
    never a dependency of the library.
  -->
  <ItemGroup>
    <ProjectReference Include="Roslyn\BH.SDK.Roslyn.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs"
             Exclude="Roslyn\**\*.cs;UnityExtensions\**\*.cs;Tests\**\*.cs;Samples~\**\*.cs;bin~\**\*.cs;obj~\**\*.cs" />
    <!--
      The one file of UnityIntegration/ that does NOT come along. Two assemblies in Unity means two
      AssemblyInfo.cs, and merging them into one here would declare InternalsVisibleTo twice for the
      same target - CS0579. The root AssemblyInfo.cs already names everyone who needs it.
    -->
    <Compile Remove="UnityIntegration\AssemblyInfo.cs" />
  </ItemGroup>

  <!--
    The same three NuGet packages the Unity project installs through NuGetForUnity (Assets/
    packages.config), at the same versions, plus Newtonsoft.Json itself - which Unity supplies as
    the com.unity.nuget.newtonsoft-json package rather than from packages.config.

    SharpZipLib MUST resolve its netstandard2.1 group; its netstandard2.0 group pulls System.Memory
    and System.Threading.Tasks.Extensions, and the latter defines ValueTask a second time (CS0433).
    Targeting netstandard2.1 above is what selects the right one.
  -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

</Project>
