# The SDK is its own repository and is also consumed outside Unity, so it carries its own rules
# rather than inheriting the game project's. Only what this repo actually contains is listed.

# Text
*.cs                    text diff=csharp
*.md                    text
*.csproj                text eol=crlf
*.props                 text eol=crlf
*.asmdef                eol=lf linguist-language=json
*.json                  eol=lf

# Build products committed on purpose: BH.SDK.Roslyn.dll in this folder is a binary that changes
# wholesale on every build, which is exactly what LFS exists for. It lives in the SDK root rather
# than in Roslyn/ because Unity scopes an analyzer to the asmdef owning its folder plus every
# assembly referencing it. Nothing here is ever diffed or merged.
*.dll                   filter=lfs diff=lfs merge=lfs -text
*.pdb                   filter=lfs diff=lfs merge=lfs -text
